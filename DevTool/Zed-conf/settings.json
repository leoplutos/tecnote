{
  "autosave": "off", //自动保存
  "format_on_save": "off", //保存时格式化
  "remove_trailing_whitespace_on_save": true,
  "ensure_final_newline_on_save": true,
  "whitespace_map": {
    "space": "•",
    "tab": "→",
  },
  "show_whitespaces": "trailing", //显示行尾空格
  "auto_update": false, //自动更新
  "confirm_quit": true, //确认退出
  "file_types": {
    "C": ["pc"],
    "Dockerfile": ["Dockerfile*", "app_dockerfile"],
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "vim_mode": false,
  "base_keymap": "VSCode",
  "ui_font_family": ".SystemUIFont", //UI字体
  "ui_font_fallbacks": [".ZedSans"], //UI字体回退
  "ui_font_size": 15,
  "buffer_font_family": "更紗等幅ゴシック J Nerd Font", //文本字体
  //"buffer_font_family": "Consolas 7NF", //文本字体
  "buffer_font_fallbacks": [
    //文本字体回退
    "Consolas",
    "Cascadia Code",
    "NSimSun",
    "ＭＳ ゴシック",
    ".ZedSans",
    ".SystemUIFont",
    "Courier New",
  ],
  "buffer_font_size": 16, // 字体大小 默认15
  "buffer_font_weight": 400, // 字体粗细 [100-900]
  // 文本高度 "comfortable" (1.618), "standard" (1.3) or custom: `{ "custom": 2 }`
  "buffer_line_height": "standard",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
  "hide_mouse": "on_typing", //输入时隐藏鼠标
  "indent_guides": {
    //缩进参考线
    "enabled": true,
  },
  "journal": {
    //小时制
    "hour_format": "hour24",
  },
  "diagnostics": {
    // error lengs
    "inline": {
      "enabled": true,
      "padding": 4,
    },
  },
  "title_bar": {
    "show_branch_icon": true,
    "show_branch_name": true,
    "show_project_items": true,
    "show_onboarding_banner": true,
    "show_user_picture": true,
    "show_user_menu": true,
    "show_sign_in": true,
    "show_menus": false,
  },
  "tabs": {
    "close_position": "right",
    "file_icons": true,
    "git_status": true,
    "activate_on_close": "history",
    "show_close_button": "hover",
    "show_diagnostics": "errors",
  },
  "outline_panel": {
    "dock": "right", //右侧显示
  },
  "status_bar": {
    "active_encoding_button": "enabled",
    "active_language_button": true,
    "cursor_position_button": true,
    "line_endings_button": true,
  },
  "project_panel": {
    "button": true,
    "entry_spacing": "standard",
    "file_icons": true,
    "folder_icons": true,
    "git_status": true,
    "auto_reveal_entries": true,
    "auto_fold_dirs": true,
    "bold_folder_labels": false,
    "drag_and_drop": true,
    "sticky_scroll": true,
    "show_diagnostics": "all",
  },
  "git": {
    "inline_blame": {
      "enabled": true, // 谁把代码改崩了？
      "show_commit_summary": true,
    },
  },
  "git_panel": {
    "tree_view": true, // 树形显示
  },
  // Terminal Font Settings
  "terminal": {
    "font_family": "更紗等幅ゴシック J Nerd Font",
    "font_size": 15,
    // Terminal line height: comfortable (1.618), standard(1.3) or `{ "custom": 2 }`
    "line_height": "standard",
    "copy_on_select": true,
    "cursor_shape": "bar",
    "blinking": "on",
    "shell": {
      "program": "C:\\Windows\\System32\\cmd.exe",
      //"program": "C:\\Windows\\System32\\cmd.exe /K C:\\qiao\\00_Tools\\Cmd\\cmdautorun.cmd",
      //"program": "C:\\Liang\\Tools\\WorkTool\\Cmd\\zed_wrapper.cmd",
      // "with_arguments": {
      //   "program": "C:\\Windows\\System32\\cmd.exe",
      //   "args": ["/K", "C:\\qiao\\00_Tools\\Cmd\\cmdautorun.cmd", "2"],
      // },
    },
    "env": {
      //"JAVA_HOME": "C:\\qiao\\00_Tools\\Java\\jdk21.0.8_9_amazon-corretto",
      //"GOROOT": "C:\\qiao\\00_Tools\\Go\\go",
      //"GOPATH": "C:\\qiao\\00_Tools\\Go\\go_global",
      //"GO111MODULE": "on",
      //"PATH": "%PATH%;C:\\Windows\\system32;C:\\Windows;C:\\Program Files\\Git\\cmd;C:\\qiao\\00_Tools\\Java\\jdk21.0.8_9_amazon-corretto\\bin;C:\\qiao\\00_Tools\\Python\\Python313;C:\\qiao\\00_Tools\\Web\\node;C:\\qiao\\00_Tools\\Go\\go\\bin;C:\\qiao\\00_Tools\\Go\\go_global\\bin;C:\\qiao\\00_Tools\\C\\mingw64\\bin",
    },
  },
  "preview_tabs": {
    //关闭预览标签页
    "enabled": false,
    "enable_preview_from_project_panel": false,
    "enable_preview_from_file_finder": false,
    "enable_preview_from_multibuffer": false,
    "enable_preview_multibuffer_from_code_navigation": false,
    "enable_preview_file_from_code_navigation": false,
    "enable_keep_preview_on_code_navigation": false,
  },
  "languages": {
    //覆盖某种语言的设置
    "JSON": {
      "tab_size": 4,
    },
  },
  "agent": {
    "use_modifier_to_send": true, // 防误触
    "single_file_review": true,
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
    },
  },
