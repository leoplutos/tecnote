	"editor.tokenColorCustomizations": {
		"[Default Dark+]": { //Default Dark+主题的自定义
			"comments": "#5f6167", //设定注释颜色(备用#606060)(备用#6A9955)
			"numbers": "#00e8ef", //设定数字颜色(备用#e5c07b)
